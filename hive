#!/usr/bin/env python3
"""hive — Freebuff 멀티에이전트 오케스트레이션 도구

Freebuff 데스크톱 앱의 내장 오케스트레이터(Bun 서버, 127.0.0.1) 로컬 API를 붙어
탭(스레드)을 벌(worker)처럼 굴린다.

  · watch   — idle 벌 자동 깨우기(컨티뉴) + .orch 인박스 자동 분배 + 야간 활동 digest
  · dispatch— 임무(플랜)를 받아 .orch/inbox 작성 후 벌 탭에 자동 전송
  · digest  — 탭별 최근 활동 요약 (outbox·대화 스냅샷 기반)
  · stats   — 토큰 추정·턴 수 등 세션 소비 통계 (시간제 요금 대응)

앱 실행 중에만 동작. 앱 재시작(포트·launchId 변경) 시 자동 재발견.
launchId는 오케스트레이터 프로세스 환경변수(FREEBUFF_LAUNCH_ID)에서 읽는다.

명령:
  hive threads                       열린 탭 목록
  hive states                        탭별 turn 상태 (running/idle)
  hive send "<탭>" "<메시지>"        탭에 메시지 전송
  hive show "<탭>" [N]               마지막 N개 메시지 요약
  hive dispatch "지시문..."          .orch/inbox 작성 + 워커 탭 전송 (자동 배분)
  hive rotate "<탭>"                 긴 탭 → 요약 심은 새 탭 → 구탭 close (컨텍스트 리셋)
  hive meter                         탭별 시간제 소비 상태
  hive sweep [분] [--dry]            오래 놀고 있는 탭 자동 정리 (기본 30분)
  hive markers                       학습된 오류 마커 목록
  hive digest [N시간]                최근 N시간 활동 요약 (기본 12)
  hive stats                         탭별 토큰 추정·턴 수 통계
  hive watch [초]                    통합 감시 루프 (기본 20초)
  hive status                        연결 정보

예:
  hive dispatch "소울 커먼더 문서 검수 3건: ①GDD_00 ②GDD_05 ③README"
  hive watch 30
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime

APP_BUNDLE = "/Applications/Freebuff.app/Contents/Resources"
ORCH_PATH = f"{APP_BUNDLE}/orchestrator/orchestrator.js"
CONTINUE_TEXT = "세션이 끊겼으면 최근 작업을 이어서 계속 진행해라. 할 일 없으면 '대기'라고만 답해라."
INBOX_PING = "인박스 확인: .orch/inbox 의 지시를 전부 처리하고 outbox 에 보고해라."
DEFAULT_INTERVAL = 20
IDLE_COOLDOWN = 300          # 같은 탭 컨티뉴 최소 간격 (초)
HEAD_TITLES = ("대가리", "HEAD")   # 지휘자로 인식할 탭 제목
WORKER_TITLES = ("워커", "W")     # 워커로 인식할 탭 제목 접두


def orch_dir():
    """프로젝트 루트의 .orch 경로 (현재 cwd 기준)."""
    return os.path.join(os.getcwd(), ".orch")


def ts():
    return time.strftime("%H:%M:%S")


def now_iso():
    return datetime.now().strftime("%Y-%m-%d %H:%M")


def find_orchestrator():
    """실행 중인 오케스트레이터 프로세스에서 port + launchId 발견."""
    out = subprocess.run(["ps", "aux"], capture_output=True, text=True, timeout=10).stdout
    for line in out.splitlines():
        if ORCH_PATH in line and "grep" not in line:
            pid = int(line.split()[1])
            env = subprocess.run(["ps", "eww", str(pid)], capture_output=True, text=True, timeout=10).stdout
            m = re.search(r"FREEBUFF_LAUNCH_ID=([0-9a-f-]+)", env)
            if not m:
                continue
            launch_id = m.group(1)
            lsof = subprocess.run(["lsof", "-p", str(pid), "-nP"], capture_output=True, text=True, timeout=10).stdout
            ports = set()
            for l in lsof.splitlines():
                if "LISTEN" not in l or "127.0.0.1" not in l:
                    continue
                m2 = re.search(r"127\.0\.0\.1:(\d+)", l)
                if m2:
                    ports.add(int(m2.group(1)))
            if ports:
                return min(ports), launch_id
    return None, None


class FB:
    def __init__(self, allow_missing=False):
        self.port, self.launch_id = find_orchestrator()
        if not self.port and not allow_missing:
            sys.exit("오류: Freebuff 앱이 실행 중이 아님 (오케스트레이터 미발견)")

    def req(self, method, path, body=None):
        url = f"http://127.0.0.1:{self.port}{path}"
        data = json.dumps(body).encode() if body is not None else None
        r = urllib.request.Request(url, data=data, method=method)
        r.add_header("x-freebuff-launch-id", self.launch_id)
        r.add_header("origin", f"http://127.0.0.1:{self.port}")
        if data:
            r.add_header("content-type", "application/json")
        try:
            with urllib.request.urlopen(r, timeout=15) as resp:
                return json.loads(resp.read().decode())
        except urllib.error.HTTPError as e:
            try:
                return json.loads(e.read().decode())
            except Exception:
                return {"error": f"HTTP {e.code}"}

    def threads(self):
        d = self.req("GET", "/api/projects")
        out = []
        for p in d.get("projects", []):
            for t in p.get("threads", []):
                out.append(t)
        return out

    def open_threads(self):
        return [t for t in self.threads() if t.get("status") == "open"]

    def thread_detail(self, thread_id):
        return self.req("GET", f"/api/thread/{thread_id}")

    def find_by_title(self, title):
        for t in self.open_threads():
            if t.get("title") == title:
                return t
        return None

    def send(self, thread_id, text):
        return self.req("POST", f"/api/thread/{thread_id}/message", {"text": text})

    def snapshot(self, thread_id):
        return self.thread_detail(thread_id).get("messages") or []


def msg_text(m):
    """메시지에서 사람이 읽을 텍스트 1줄 추출."""
    for p in (m.get("parts") or []):
        if not isinstance(p, dict):
            continue
        kind = p.get("kind") or p.get("type")
        if kind in ("text", "user_input"):
            return str(p.get("text", ""))[:160]
        if kind == "tool":
            return f"⟨{p.get('toolName', 'tool')}⟩"
    return "(빈 메시지)"


def summarize_messages(msgs, n=6):
    out = []
    for m in msgs[-n:]:
        out.append(f"[{m.get('role', '?')}] {msg_text(m)}")
    return out


def turn_state(fb, thread_id):
    t = fb.thread_detail(thread_id).get("thread", {})
    return t.get("turnState")


def last_is_user(msgs):
    return bool(msgs) and msgs[-1].get("role") == "user"


# 세션 종료·공급자 오류 마커 — 전송 기록에 사용자 메시지로 박히지만 실제 유저 입력이 아님.
# 이게 마지막 메시지면 "큐 대기"가 아니라 "끊긴 상태"이므로 컨티뉴 대상이 된다.
SESSION_END_MARKERS = (
    "your session ended",
    "free session ended",
    "free session ran out",
    "session ended before this request started",
    "upstream provider error",
    "continue the interrupted request",
    "agent run error",
    "failed after",
    "attempts. last error",
    "internal server error",
    "api call error",
    "rate limit",
    "overloaded",
    "network error",
    "timeout while",
    "request failed",
)


def is_session_end_marker(text):
    t = (text or "").lower()
    if any(m in t for m in SESSION_END_MARKERS):
        return True
    # 학습형 마커 — 현장에서 발견해 저장한 패턴도 인정
    for m in load_markers():
        if m and m.lower() in t:
            return True
    return False


MARKERS_FILE = os.path.expanduser("~/.hive/markers.json")


def load_markers():
    try:
        with open(MARKERS_FILE, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return []


def save_markers(markers):
    os.makedirs(os.path.dirname(MARKERS_FILE), exist_ok=True)
    with open(MARKERS_FILE, "w", encoding="utf-8") as f:
        json.dump(markers, f, ensure_ascii=False, indent=1)


def learn_marker(text):
    """미인식 실패 패턴 학습. lastTurnOutcome=error 인 순간의 마지막 메시지 텍스트에서 추출.
    내장 마커로 이미 커버되면 스킵. 최대 50개."""
    line = (text or "").strip().splitlines()[0][:60] if (text or "").strip() else ""
    if not line or is_session_end_marker(line):
        return False
    markers = load_markers()
    key = line.lower()
    if any(key in m.lower() or m.lower() in key for m in markers):
        return False
    markers.append(line)
    save_markers(markers[-50:])
    print(f"[{ts()}] ◆ 새 오류 패턴 학습: {line!r}", flush=True)
    return True


def cmd_markers(fb):
    builtin = len(SESSION_END_MARKERS)
    learned = load_markers()
    print(f"내장 마커 {builtin}개 + 학습 마커 {len(learned)}개 (파일: {MARKERS_FILE})")
    for m in learned:
        print(f"  · {m}")
    print("초기화: 파일 삭제")
    return 0


def is_head(title):
    return any(title == h or title.startswith(h) for h in HEAD_TITLES)


def is_worker(title):
    return any(title.startswith(w) for w in WORKER_TITLES) and not is_head(title)


# ---------------------------------------------------------------- threads/쇼

def cmd_threads(fb):
    for t in fb.open_threads():
        print(f"{t['id'][:8]}  {t.get('status')}  {t.get('title')}")
    return 0


def cmd_states(fb):
    for t in fb.open_threads():
        st = turn_state(fb, t["id"])
        role = "HEAD" if is_head(t.get("title", "")) else ("worker" if is_worker(t.get("title", "")) else "-")
        print(f"{t['id'][:8]}  turn={st or '?':9}  [{role}]  {t.get('title')}")
    return 0


def cmd_send(fb, title, text):
    t = fb.find_by_title(title)
    if not t:
        print(f"오류: 열린 탭 '{title}' 없음. `hive threads` 로 확인.")
        return 1
    r = fb.send(t["id"], text)
    print(json.dumps(r, ensure_ascii=False))
    return 0 if r.get("ok") else 1


def cmd_send_id(fb, tid, text):
    r = fb.send(tid, text)
    print(json.dumps(r, ensure_ascii=False))
    return 0 if r.get("ok") else 1


def cmd_show(fb, title, n=6):
    t = fb.find_by_title(title)
    if not t:
        print(f"오류: 열린 탭 '{title}' 없음.")
        return 1
    for line in summarize_messages(fb.snapshot(t["id"]), n):
        print(line)
    return 0


# ---------------------------------------------------------------- dispatch

def cmd_dispatch(fb, mission_text):
    """임무문을 받아 .orch/inbox 에 기록 후 워커 탭에 전송."""
    od = orch_dir()
    inbox = os.path.join(od, "inbox")
    os.makedirs(inbox, exist_ok=True)
    os.makedirs(os.path.join(od, "outbox"), exist_ok=True)

    # 워커 탭 자동 발견 (제목에 '워커' 포함)
    workers = [t for t in fb.open_threads() if is_worker(t.get("title", ""))]
    if not workers:
        print("오류: 워커 탭('워커'로 시작하는 제목)이 없다. 탭을 먼저 띄워라.")
        return 1

    # 각 워커 inbox 에 임무 기록 (기존 내용 append)
    for i, w in enumerate(sorted(workers, key=lambda x: x.get("title", "")), 1):
        title = w.get("title", f"워커{i}")
        num = re.search(r"(\d+)", title)
        wnum = num.group(1) if num else str(i)
        path = os.path.join(inbox, f"W{wnum}.md")
        header = f"\n## [{now_iso()}] HEAD — dispatch\n\n{mission_text}\n\n- verify: outbox/W{wnum}.md 에 보고. 끝나면 'W{wnum} 완료' 1줄.\n"
        with open(path, "a", encoding="utf-8") as f:
            f.write(header)
        r = fb.send(w["id"], INBOX_PING)
        ok = "▶ 전송" if r.get("ok") else f"✗ {r.get('error')}"
        print(f"[{ts()}] {title}: inbox/W{wnum}.md 기록 + {ok}")
    return 0


# ---------------------------------------------------------------- digest

def _read_outbox_tail(limit_lines=12):
    od = orch_dir()
    out = []
    outbox = os.path.join(od, "outbox")
    if not os.path.isdir(outbox):
        return out
    for name in sorted(os.listdir(outbox)):
        path = os.path.join(outbox, name)
        try:
            with open(path, encoding="utf-8") as f:
                lines = [l.rstrip() for l in f if l.strip()]
        except OSError:
            continue
        out.append(f"  {name}: …" + " / ".join(lines[-limit_lines:])[:300])
    return out


def cmd_digest(fb, hours=12):
    cutoff = time.time() - hours * 3600
    print(f"══ hive digest — 최근 {hours}시간 ({now_iso()}) ══")
    for t in fb.open_threads():
        title = t.get("title", "?")
        msgs = fb.snapshot(t["id"])
        recent = [m for m in msgs if (m.get("createdAt") or 0) / 1000 >= cutoff] if msgs and isinstance(msgs[0].get("createdAt"), (int, float)) else msgs[-12:]
        print(f"\n■ {title}  (turn={turn_state(fb, t['id']) or '?'}, 최근 메시지 {len(recent)}개)")
        for line in summarize_messages(recent, 8):
            print(f"  {line}")
    od_lines = _read_outbox_tail()
    if od_lines:
        print("\n■ .orch/outbox 보고서")
        for l in od_lines:
            print(l)
    print("\n(끝) — 상세: hive show \"<탭>\" 30")
    return 0


# ---------------------------------------------------------------- stats (토큰 추정)

def _estimate_tokens(msgs):
    """대략: 텍스트 4자≈1토큰 근사 (한국어 1.5자≈1토큰 보정)."""
    chars = 0
    turns = 0
    for m in msgs:
        turns += 1
        for p in (m.get("parts") or []):
            if isinstance(p, dict):
                t = p.get("text")
                if t:
                    chars += len(str(t))
                else:
                    chars += 40   # tool 콜/결과 평균 보정
    return int(chars / 3.2), turns   # 3.2자/토큰 혼합 근사


def cmd_stats(fb):
    print(f"══ hive stats — 세션 소비 추정 ({now_iso()}) ══")
    print(f"{'탭':24} {'턴':>5} {'토큰(추정)':>12} {'5h윈도우%':>9}")
    total = 0
    for t in fb.open_threads():
        msgs = fb.snapshot(t["id"])
        tok, turns = _estimate_tokens(msgs)
        total += tok
        # 참고: Claude 5시간 롤링 윈도우 한도를 대략 220k 토큰으로 가정한 표시용
        pct = min(100, tok * 100 // 220_000)
        print(f"{t.get('title','?')[:24]:24} {turns:>5} {tok:>12,} {pct:>8}%")
    print(f"{'합계(추정)':24} {'':>5} {total:>12,}")
    print("\n※ 추정치: 스냅샷 텍스트 기준 근사. 시스템 프롬프트·캐시 미포함 → 실제 청구보다 낮게 나옴.")
    print("  절감 팁: hive watch 쿨다운 유지, dispatch로 배치 전송(턴 수↓), 컨텍스트 긴 탭은 새 세션 권장.")
    return 0


# ---------------------------------------------------------------- brain (로컬 결정 엔진 — 옵트인)

BRAIN_PORT = int(os.environ.get("HIVE_BRAIN_PORT", "8777"))
BRAIN_PID_FILE = os.path.expanduser("~/.hive-brain.pid")
BRAIN_MODEL_PATH = os.path.expanduser("~/hive-models/MiniCPM5-2B-Q4_K_M.gguf")


def brain_status():
    """(실행중?, pid, 비고) — pid 파일 기반 llama-server 확인."""
    try:
        with open(BRAIN_PID_FILE) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return True, pid, "llama-server 실행 중"
    except (FileNotFoundError, ProcessLookupError, ValueError, PermissionError):
        return False, None, "미실행 — fallback 휴리스틱 전용 (RAM 0)"


def brain_on(model=None, threads=3):
    """로컬 결정 서버 수동 기동. RAM 1.5~2.5GB 상주 — 명시적 옵트인만."""
    running, pid, _ = brain_status()
    if running:
        print(f"이미 실행 중 (pid {pid}).")
        return 0
    model = model or os.environ.get("HIVE_BRAIN_MODEL", os.path.expanduser("~/hive-models/MiniCPM5-2B-Q4_K_M.gguf"))
    if not shutil.which("llama-server"):
        print("llama-server 없음. 설치: brew install llama.cpp")
        return 1
    if not os.path.exists(model):
        print(f"모델 없음: {model}")
        print("다운로드: curl -L -o ~/hive-models/MiniCPM5-2B-Q4_K_M.gguf \\")
        print("  https://huggingface.co/bartowski/MiniCPM5-2B-GGUF/resolve/main/MiniCPM5-2B-Q4_K_M.gguf")
        return 1
    print("⚠️ RAM 1.5~2.5GB 상주 시작. 끄려면: hive brain off")
    proc = subprocess.Popen(
        ["llama-server", "-m", model, "--host", "127.0.0.1", "--port", str(BRAIN_PORT),
         "-c", "2048", "-t", str(threads)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    with open(BRAIN_PID_FILE, "w") as f:
        f.write(str(proc.pid))
    for _ in range(60):
        time.sleep(1)
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{BRAIN_PORT}/health", timeout=2) as r:
                if r.status == 200:
                    print(f"[{ts()}] 브레인 기동 완료 (port {BRAIN_PORT}, pid {proc.pid})")
                    return 0
        except Exception:
            pass
    print("헬스체크 실패 — 로그 확인 요망")
    return 1


def brain_off():
    running, pid, _ = brain_status()
    if running:
        os.kill(pid, signal.SIGTERM)
        print(f"브레인 종료 (pid {pid}). RAM 반환.")
    try:
        os.remove(BRAIN_PID_FILE)
    except FileNotFoundError:
        pass
    return 0


def brain_decide(state, question, options):
    """로컬 모델에 결정 질의. options: [(id, desc)]. 반환: {id, prob} 또는 None."""
    body = {
        "prompt": (
            "You are a decision engine. Apply the criterion to the evidence. "
            "Answer with exactly one option letter, nothing else.\n\n"
            f"EVIDENCE: {state}\n\nCRITERION: {question}\n"
            + "\n".join(f"  {chr(65+i)}. {d}" for i, (_, d) in enumerate(options))
            + "\n\nANSWER LETTER:"
        ),
        "n_predict": 1, "temperature": 0.0, "n_probs": 24, "cache_prompt": True,
    }
    req = urllib.request.Request(
        f"http://127.0.0.1:{BRAIN_PORT}/completion",
        data=json.dumps(body).encode(), method="POST",
        headers={"content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        d = json.loads(r.read().decode())
    probs = (d.get("completion_probabilities") or [{}])[0].get("probs") or []
    # 옵션 글자 토큰의 확률만 모아 정규화 (상위 토큰에 없는 글자는 확률 0 취급)
    letter_probs = {}
    for p in probs:
        tok = (p.get("tok_str") or p.get("tok", "")).strip()
        if tok in [chr(65 + i) for i in range(len(options))]:
            letter_probs[tok] = max(letter_probs.get(tok, 0.0), p.get("prob", 0.0))
    if not letter_probs:
        return None
    total = sum(letter_probs.values())
    best = max(letter_probs, key=letter_probs.get)
    idx = ord(best) - 65
    return {"id": options[idx][0], "prob": letter_probs[best] / total if total else 0.0}


def decide(state, question, options):
    """결정 제공자: local(실행 중이면) → fallback(항상). 반환 (winner_id, prob, backend)."""
    running, _, _ = brain_status()
    if running:
        try:
            r = brain_decide(state, question, options)
            if r:
                return r["id"], r["prob"], "local"
        except Exception:
            pass
    return None, 0.0, "fallback"


def cmd_brain(fb, rest):
    if not rest or rest[0] == "status":
        running, pid, note = brain_status()
        print(f"브레인: {'실행 중' if running else '꺼짐'} ({note})")
        print("정책: fallback 휴리스틱이 기본. RAM 걱정 시 끄지 않아도 됨 — 미실행 시 RAM 0.")
        return 0
    if rest[0] == "on":
        return brain_on()
    if rest[0] == "off":
        return brain_off()
    print(__doc__)
    return 1


def cmd_decide_test(fb, state, question, opts):
