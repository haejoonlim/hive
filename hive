# ---------------------------------------------------------------- sweep (안 쓰는 탭 정리)

SWEEP_IDLE_MIN = int(os.environ.get("HIVE_SWEEP_IDLE_MIN", "30"))     # 30분 이상 idle
SWEEP_KEEP = ("대가리", "HEAD")                                        # 보호 대상 탭 접두
SWEEP_LOG = os.path.expanduser("~/.hive/sweep-log.json")


def _protect(title):
    return is_head(title) or title in ("논술공방 확인과 과제",) or title.endswith("(rotate)")


def cmd_sweep(fb, idle_min=None, dry=False):
    """오래 놀고 있는 열린 탭을 조사해 close(아카이브). 창이 많으면 UI가 느려지므로 정리.
    보호: HEAD, 현재 rotate된 탭, 사용자 지정. 기본 idle 30분.
    복구: closed 탭은 UI에서 다시 열 수 있음(archive → 재개 가능)."""
    idle_min = idle_min or SWEEP_IDLE_MIN
    now_ms = time.time() * 1000
    swept = []
    kept = []
    for t in fb.open_threads():
        title = t.get("title", "")
        if _protect(title):
            kept.append((title, "보호 대상"))
            continue
        d = fb.thread_detail(t["id"]).get("thread", {})
        state = d.get("turnState")
        outcome = d.get("lastTurnOutcome")
        fin = d.get("lastTurnFinishedAt")
        idle = max(0.0, (now_ms - fin) / 60000.0) if fin else 999.0
        if state == "running":
            kept.append((title, "실행 중"))
            continue
        if idle < idle_min:
            kept.append((title, f"idle {idle:.0f}분 < {idle_min}분"))
            continue
        # 미완료(outcome != completed)면 close하지 않고 보고만 — 데이터 손실 방지
        if outcome not in ("completed", None):
            kept.append((title, f"미완료(outcome={outcome}) — close 보류"))
            continue
        if dry:
            swept.append((title, t["id"], "dry-run"))
            continue
        r = fb.req("POST", f"/api/thread/{t['id']}/close", {})
        if r.get("ok"):
            swept.append((title, t["id"], f"idle {idle:.0f}분"))
        else:
            kept.append((title, f"close 실패: {r.get('error')}"))
    print(f"══ hive sweep — idle {idle_min}분+ 탭 정리{'(dry-run)' if dry else ''} ══")
    for title, why in kept:
        print(f"  유지: {title[:28]:28} {why}")
    for title, tid, why in swept:
        print(f"  닫음: {title[:28]:28} {why}")
    if swept and not dry:
        log = []
        try:
            with open(SWEEP_LOG, encoding="utf-8") as f:
                log = json.load(f)
        except Exception:
            pass
        log.append({"at": now_iso(), "closed": [t[0] for t in swept]})
        os.makedirs(os.path.dirname(SWEEP_LOG), exist_ok=True)
        with open(SWEEP_LOG, "w", encoding="utf-8") as f:
            json.dump(log[-30:], f, ensure_ascii=False, indent=1)
    print(f"\n결과: 닫음 {len(swept)}개 / 유지 {len(kept)}개. 닫힌 탭은 앱에서 재열 수 있음.")
    return 0


def cmd_rotate(fb, title_or_id):
    """긴 탭 → 마지막 어시스턴트 텍스트로 상태 요약 심은 새 탭 생성 → 구탭 close.
    TokenPilot 근거: 컨텍스트 리셋이 장기 세션 비용의 최대 절감점 (61~87%)."""
    t = fb.find_by_title(title_or_id)
    if not t:
        for x in fb.open_threads():
            if x["id"].startswith(title_or_id):
                t = x
                break
    if not t:
        print(f"오류: 열린 탭 '{title_or_id}' 없음.")
        return 1
    tid, title = t["id"], t.get("title", "?")
    project = t.get("projectPath") or t.get("projectId")
    msgs = fb.snapshot(tid)
    tok, turns = _estimate_tokens(msgs)
    # 요약 재료: 마지막 어시스턴트 텍스트 + 최근 유저 지시 3개
    a_texts = [msg_text(m) for m in msgs if m.get("role") == "assistant"]
    u_texts = [msg_text(m) for m in msgs if m.get("role") == "user"]
    summary = a_texts[-1] if a_texts else "(요약 재료 없음)"
    recent = "\n".join(f"- {u}" for u in u_texts[-3:])
    seed = (
        f"[rotate] 이전 세션 '{title}' (턴 {turns}개, 컨텍스트 추정 {tok:,})에서 이어받은 탭이다.\n\n"
        f"## 직전 상태 요약\n{summary[:1200]}\n\n"
        f"## 최근 지시 흐름\n{recent[:800]}\n\n"
        "이 요약을 기준으로 작업을 계속하라. 요약에 없는 건 이전 탭(.orch/outbox 또는 git)에서 확인."
    )
    # 1) 새 탭 생성
    r = fb.req("POST", "/api/threads", {"projectPath": project, "title": f"{title} (rotate)"})
    if "id" not in r:
        print(f"오류: 새 탭 생성 실패 — {r.get('error')}")
        return 1
    new_id = r["id"]
    print(f"[{ts()}] 새 탭 생성: {new_id[:8]} '{title} (rotate)'")
    # 2) 요약 심기 (첫 메시지 = 새 세션 컨텍스트)
    r2 = fb.send(new_id, seed)
    if not r2.get("ok"):
        print(f"오류: 요약 심기 실패 — {r2.get('error')}")
        return 1
    print(f"[{ts()}] 요약 심기 완료 ({len(seed)}자)")
    # 3) 구탭 close (세션 반납 → 시간제 회수)
    r3 = fb.req("POST", f"/api/thread/{tid}/close", {})
    if not r3.get("ok"):
        print(f"오류: 구탭 close 실패 — {r3.get('error')}")
        return 1
    print(f"[{ts()}] 구탭 close: {tid[:8]} — 세션 반납, 시간제 회수")
    print(f"완료: '{title}' → '{title} (rotate)'. 컨텍스트 {tok:,} → 0")
    return 0


# ---------------------------------------------------------------- meter (시간제 소비 감시)

def cmd_meter(fb):
    """탭별 시간제 소비 상태. Freebuff는 모델별 시간제(Freebucks/hour)이며,
    idle 15분(FREEBUFF_DESKTOP_IDLE_RELEASE_MS=900000)이면 세션 자동 반납."""
    now_ms = time.time() * 1000
    print(f"══ hive meter — 시간제 소비 상태 ({now_iso()}) ══")
    print(f"{'탭':20} {'모델':22} {'상태':14} {'idle':>7}  판정")
    burning = 0
    for t in fb.open_threads():
        d = fb.thread_detail(t["id"]).get("thread", {})
        title = d.get("title", "?")[:20]
        model = (d.get("model") or "-")[:22]
        state = d.get("turnState") or "?"
        fin = d.get("lastTurnFinishedAt")
        idle_min = max(0.0, (now_ms - fin) / 60000.0) if fin else -1
        if state == "running":
            verdict, mark = "● 소비 중", "B"
            burning += 1
        elif idle_min < 15:
            verdict, mark = f"◐ 유예 중 (반납까지 {15 - idle_min:.0f}분)", "H"
        else:
            verdict, mark = "○ 반납됨 (15분 경과) — 시간 미소비", "-"
        idle_s = f"{idle_min:.0f}분" if idle_min >= 0 else "-"
        print(f"{title:20} {model:22} [{mark}] {idle_s:>7}  {verdict}")
    print(f"\n소비 중: {burning}개 탭.")
    print("유예 중 탭은 15분 후 자동 반납 — 건드리지 않는 게 이득. 의미 없는 컨티뉴는 반납을 취소하고 시간을 태움.")
    return 0


# ---------------------------------------------------------------- watch (통합 루프)

def cmd_watch(fb, interval):
    print(f"watch 시작 (interval={interval}s). Freebuff 앱 대기 중에도 유지.", flush=True)
    cooldown = {}
    inbox_ping_cooldown = {}
    stuck_note = {}      # 마지막 어시스턴트 텍스트 → 반복 감지
    stuck_log_at = {}    # 스킵 로그 스팸 방지
    rotate_log_at = {}   # rotate 제안 로그 스팸 방지 (6시간)
    sweep_every = 1800   # 30분마다 한 번씩 안 쓰는 탭 정리
    last_sweep = 0.0
    app_wait = False
    while True:
        try:
            if fb.port is None:
                # 앱 꺼짐 상태 — 10초마다 재발견 시도 (앱 켜지면 자동 작동)
                if not app_wait:
                    print(f"[{ts()}] Freebuff 미실행 — 앱 켜질 때까지 대기...", flush=True)
                    app_wait = True
                time.sleep(10)
                try:
                    fb2 = FB()
                    fb.port, fb.launch_id = fb2.port, fb2.launch_id
                    print(f"[{ts()}] Freebuff 감지됨 (port={fb.port}) — 감시 재개", flush=True)
                    app_wait = False
                except SystemExit:
                    continue
                continue
            # 0) 주기적 탭 정리 (창 과다로 인한 UI 느려짐 방지)
            if time.time() - last_sweep > sweep_every:
                try:
                    n = cmd_sweep(fb, None, False)
                    last_sweep = time.time()
                except Exception as e:
                    print(f"[{ts()}] sweep 오류: {e}", flush=True)
            for t in fb.open_threads():
                tid = t["id"]
                title = t.get("title", "")
                # HEAD 탭(사람-지휘자 대화)은 자동 깨우기 금지 — 무의미한 토큰 소모 방지
                if is_head(title):
                    continue
                detail = fb.thread_detail(tid).get("thread", {})
                state = detail.get("turnState")
                failed = detail.get("lastTurnOutcome") == "error"
                if state == "running":
                    cooldown.pop(tid, None)
                    continue
                msgs = fb.snapshot(tid)
                if last_is_user(msgs):
                    # 마지막이 사용자 메시지여도 세션 종료·공급자 오류(또는 학습된 마커)면 컨티뉴 대상
                    if not failed and not is_session_end_marker(msg_text(msgs[-1])):
                        continue
                    learn_marker(msg_text(msgs[-1]))
                now = time.time()
                # 1) 워커 + .orch/inbox 에 새 지시 있으면 인박스 확인 전송
                if is_worker(title):
                    inbox = os.path.join(orch_dir(), "inbox")
                    if os.path.isdir(inbox):
                        num = re.search(r"(\d+)", title)
                        wfile = os.path.join(inbox, f"W{num.group(1)}.md" if num else f"W{title[-1]}.md")
                        if os.path.exists(wfile):
                            mtime = os.path.getmtime(wfile)
                            if mtime > inbox_ping_cooldown.get(tid, 0) and now - mtime > 5:
                                r = fb.send(tid, INBOX_PING)
                                if r.get("ok"):
                                    inbox_ping_cooldown[tid] = now
                                    print(f"[{ts()}] {title}: ▶ 인박스 확인 전송 (새 지시 감지)", flush=True)
                                    continue
                # 2) 공통: idle 컨티뉴 — Smart Watch 휴리스틱 (결정론, RAM 0)
                # 시간제 주의: idle 15분이면 앱이 세션을 반납(FREEBUFF_DESKTOP_IDLE_RELEASE_MS=900000 실측).
                # 의미 없는 컨티뉴는 반납을 방해해서 시간제를 태운다 — 완료/대기/정체는 깨우지 않는다.
                a_texts = [msg_text(m).strip() for m in msgs if m.get("role") == "assistant"]
                last_a = a_texts[-1] if a_texts else ""
                if failed:
                    pass  # lastTurnOutcome=error — 아래 컨티뉴로 즉시 복구 (대기·완료 스킵 미적용)
                elif last_a == "대기" or last_a.endswith("완료"):
                    continue  # 할 일 없음/작업 완료 보고 — 새 지시 감지 전까지 깨우지 않음
                # 반복 정체(루프) 감지: 직전 두 어시스턴트 텍스트 동일 → 깨우지 않음
                if len(a_texts) >= 2 and a_texts[-1] == a_texts[-2] and a_texts[-1] not in ("", "대기"):
                    if now - stuck_log_at.get(tid, 0) > 1800:
                        print(f"[{ts()}] {title}: ◇ 반복 정체 감지 — 스킵 (동일 응답 2회 연속)", flush=True)
                        stuck_log_at[tid] = now
                    continue
                # rotate 후보 감지: 컨텍스트 적체 (결정만 기록, 실행은 rotate)
                tok, _turns = _estimate_tokens(msgs)
                if tok >= 400_000 and now - rotate_log_at.get(tid, 0) > 21600:
                    print(f"[{ts()}] {title}: ⚠ 컨텍스트 {tok:,} 추정 — rotate 후보. 권장: hive rotate '{title}'", flush=True)
                    rotate_log_at[tid] = now
                # 워커가 아닌 탭(사용자 작업 탭)은 긴 쿨다운 — 실수로 시간제 태우는 것 방지
                eff_cooldown = IDLE_COOLDOWN if is_worker(title) else 1800
                if now - cooldown.get(tid, 0) < eff_cooldown:
                    continue
                # (브레인 켜져 있으면 여기서 decide()로 continue 여부 판단 — 옵트인)
                r = fb.send(tid, CONTINUE_TEXT)
                if r.get("ok"):
                    cooldown[tid] = now
                    print(f"[{ts()}] {title}: ▶ 컨티뉴 전송", flush=True)
                else:
                    print(f"[{ts()}] {title}: ✗ {r.get('error')}", flush=True)
        except SystemExit:
            print("앱 종료 감지. 앱 켜질 때까지 대기 모드...", flush=True)
            fb.port, fb.launch_id = None, None
            app_wait = True
        except Exception as e:
            err = str(e)
            if "getaddrinfo" in err or "Connection refused" in err or "URLError" in err or "connection" in err.lower():
                print(f"[{ts()}] 앱 연결 끊김 — 대기 모드 전환", flush=True)
                fb.port, fb.launch_id = None, None
                app_wait = True
            else:
                print(f"감시 오류: {e}", flush=True)
        time.sleep(interval)


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 1
    cmd, rest = args[0], args[1:]
    if cmd == "status":
        port, lid = find_orchestrator()
        print(f"port={port} launchId={lid}")
        return 0
    fb = FB()
    if cmd == "threads":
        return cmd_threads(fb)
    if cmd == "states":
        return cmd_states(fb)
    if cmd == "send" and len(rest) == 2:
        return cmd_send(fb, rest[0], rest[1])
    if cmd == "send-id" and len(rest) == 2:
        return cmd_send_id(fb, rest[0], rest[1])
    if cmd == "show" and rest:
        return cmd_show(fb, rest[0], int(rest[1]) if len(rest) > 1 else 6)
    if cmd == "dispatch" and rest:
        return cmd_dispatch(fb, " ".join(rest))
    if cmd == "digest":
        return cmd_digest(fb, int(rest[0]) if rest and rest[0].isdigit() else 12)
    if cmd == "stats":
        return cmd_stats(fb)
    if cmd == "meter":
        return cmd_meter(fb)
    if cmd == "rotate" and rest:
        return cmd_rotate(fb, rest[0])
    if cmd == "sweep":
        dry = "--dry" in rest
        mins = next((int(x) for x in rest if x.isdigit()), None)
        return cmd_sweep(fb, mins, dry)
    if cmd == "markers":
        return cmd_markers(fb)
    if cmd == "brain":
        return cmd_brain(fb, rest)
    if cmd == "decide" and len(rest) >= 3:
        return cmd_decide_test(fb, rest[0], rest[1], rest[2])
    if cmd == "watch":
        return cmd_watch(fb, int(rest[0]) if rest and rest[0].isdigit() else DEFAULT_INTERVAL)
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
